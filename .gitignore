# macOS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Node
# No trailing slash: worktrees link node_modules from the main checkout.
node_modules
.pnpm-store/
.cache/
dist/

# mise — machine-local overrides and their lockfiles. mise.toml and mise.lock are committed.
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise/locks/mise.local/

# hk — machine-local hook overrides. hk.pkl is committed.
hk.local.pkl

# fnox — machine-local secret overrides. fnox.toml is committed; it holds no values.
fnox.local.toml

# Docs site (VitePress)
docs/.vitepress/cache/
docs/.vitepress/dist/

# Environment
.env
.env.*
!.env.example

# Logs and temp
*.log
*.pid
*.tmp

# Tests
coverage/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Rust
/target/
