# macOS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Node
# No trailing slash: worktrees link node_modules from the main checkout.
node_modules
.pnpm-store/
.cache/
dist/

# mise — machine-local overrides and their lockfiles. mise.toml and mise.lock are committed.
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise/locks/mise.local/

# hk — machine-local hook overrides. hk.pkl is committed.
hk.local.pkl

# The Workbench package link: machine-local, recreated by `mise install`.
.workbench

# Environment: Varlock reads .env.schema (committed) and values from the process environment or
# a gitignored .env.local.
.env
.env.*
!.env.schema

# Logs and temp
*.log
*.pid
*.tmp

# Tests
coverage/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Rust build output, and the release archives `mise run package` writes. Cargo.lock is
# committed: it makes a release reproducible.
/target/
/artifacts/
