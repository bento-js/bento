{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 100,
    "indentWidth": 4,
    "useTabs": false,
    "newLineKind": "lf",
    "markdown": {
        "textWrap": "never"
    },
    "yaml": {
        "indentWidth": 4
    },
    "toml": {
        "comment.forceLeadingSpace": false
    },
    "excludes": [
        "target/**",
        "artifacts/**",
        ".beads/**",
        "docs/public/**",
        "docs/resources/**",
        "fixtures/**",
        "bench/results/**",
        "bench/src/samples/**",
        "Cargo.lock",
        "mise.lock",
        "pnpm-lock.yaml",
        "CHANGELOG.md"
    ],
    "plugins": [
        "https://plugins.dprint.dev/markdown-0.29.0.wasm",
        "https://plugins.dprint.dev/json-0.26.0.wasm",
        "https://plugins.dprint.dev/toml-0.10.0.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
    ]
}
