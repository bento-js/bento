{
    "$schema": "node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": [
        // Built and cached by `mise run docs:build`.
        "docs/.vitepress/dist/**",
        "docs/.vitepress/cache/**",
        // The fixture is an independent project with its own toolchain and lockfile,
        // and bench/results holds recorded benchmark output kept exactly as the
        // harness wrote it.
        "bench/results/**",
        "fixtures/**",
        "target/**",
        "*-lock.yaml",
        // pnpm rewrites this itself, so oxfmt would only fight it.
        "pnpm-workspace.yaml"
    ],
    "printWidth": 100,
    "tabWidth": 4,
    "arrowParens": "avoid",
    "sortPackageJson": true,
    "sortImports": {
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            "type-internal",
            "value-internal",
            ["type-parent", "type-sibling", "type-index"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown"
        ],
        "partitionByComment": true
    },
    "overrides": [
        {
            "files": ["**/*.md", "**/*.mdx"],
            "options": { "proseWrap": "never" }
        },
        {
            "files": ["**/*.jsonc"],
            "options": { "trailingComma": "none" }
        }
    ]
}
