{
    "$schema": "node_modules/oxfmt/configuration_schema.json",
    // Oxfmt owns TypeScript and JavaScript. dprint owns Markdown, JSON, YAML and TOML
    // (dprint.json). hk passes Oxfmt only its own files; these patterns keep a bare `oxfmt`
    // run off the others too.
    "ignorePatterns": [
        "**/*.md",
        "**/*.json",
        "**/*.jsonc",
        "**/*.yml",
        "**/*.yaml",
        "**/*.toml",
        // The fixture is an independent project with its own toolchain and lockfile,
        // and bench/results holds recorded benchmark output kept exactly as the
        // harness wrote it.
        "bench/results/**",
        "fixtures/**",
        "docs/public/**",
        "target/**"
    ],
    "printWidth": 100,
    "tabWidth": 4,
    "arrowParens": "avoid",
    "sortImports": {
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            "type-internal",
            "value-internal",
            ["type-parent", "type-sibling", "type-index"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown"
        ],
        "partitionByComment": true
    }
}
