# The environment Bento's credentialed tasks read. Varlock loads this schema for them: `mise run
# release` runs `varlock run --filter GITHUB_TOKEN -- knope release`, loading only that item.
# Values come from the process environment (in CI, a job's `env:`) or a gitignored .env.local;
# never commit a value. `mise run check` reads none of these.
#
# GitHub Actions credentials: release.yml's `release` job passes the built-in GITHUB_TOKEN, so no
# stored secret is involved.
# @defaultSensitive=false @defaultRequired=false
# ---

# GitHub token `knope release` uses to tag the release and publish it with its archives. In
# release.yml this is the workflow's built-in GITHUB_TOKEN, with `contents: write` on that job
# only; `mise run release` fails without it.
# @sensitive @required @type=string
GITHUB_TOKEN=
