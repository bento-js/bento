{
    // pnpm writes pnpm-workspace.yaml in its own style, and it stays exactly as imported.
    "ignorePatterns": ["pnpm-workspace.yaml"],
    "printWidth": 100,
    "tabWidth": 4,
    "arrowParens": "avoid",
    "sortPackageJson": true,
    "sortImports": {
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            "type-internal",
            "value-internal",
            ["type-parent", "type-sibling", "type-index"],
            ["value-parent", "value-sibling", "value-index"],
            "unknown",
        ],
        "partitionByComment": true,
    },
}
