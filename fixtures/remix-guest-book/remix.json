{
    "$schema": "node_modules/remix/schema/remix.json",
    "assets": {
        "basePath": "/assets",
        "allowFiles": ["app/routes.ts", "app/**/public/**"],
        "allowPackages": ["remix"],
        "denyFiles": ["app/**/*.test.*"]
    },
    "db": {
        "adapter": {
            "type": "sqlite",
            "filename": { "env": "DATABASE_URL", "default": "./db/data.db" }
        },
        "migrations": {
            "directory": "./db/migrations"
        }
    }
}
