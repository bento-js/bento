{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "verbatimModuleSyntax": true
    },
    "exclude": [
        "node_modules",
        // Checked as its own project: tools/tsconfig.json adds `erasableSyntaxOnly`, because
        // Node runs those files by stripping types rather than compiling them.
        "tools"
    ],
    "include": ["vitest.config.ts", "bench/**/*.ts"]
}
